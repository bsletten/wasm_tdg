package wasmtdg:calculator@0.1.0;

/// The contract between the two components. Note that it says nothing about
/// Rust, or about linear memory layout, or about calling conventions -- those
/// are the component model's job. An implementation of this interface could
/// be written in any language that compiles to a component.
interface ages {
    /// How old is someone born in `year-born` during `year-now`?
    /// Returns -1 if they have not been born yet.
    how-old: func(year-now: s32, year-born: s32) -> s32;
}

world calculator {
    export ages;
}

/// The *consumer* side. It only declares what it needs; the `wasi:cli/run`
/// export that makes it a runnable command is added by the Rust toolchain
/// when it targets `wasm32-wasip2`.
world app {
    import ages;
}
